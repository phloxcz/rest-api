{
    "name": "phloxcz/rest-api",
    "description": "REST server for Nette: API controllers as DI services, with attribute-based routing, authorization and typed parameters.",
    "keywords": ["nette", "api", "rest"],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/phloxcz/rest-api",
    "authors": [
        {
            "name": "Phlox",
            "homepage": "https://github.com/phloxcz"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../phlox-api-core",
            "options": {
                "versions": {
                    "phloxcz/api-core": "0.2.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../phlox-rpc-api",
            "options": {
                "versions": {
                    "phloxcz/rpc-api": "0.2.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "nette/di": "^3.1",
        "nette/http": "^3.2",
        "nette/schema": "^1.3",
        "nette/utils": "^4.0",
        "phloxcz/api-core": "^0.2@dev"
    },
    "require-dev": {
        "nette/application": "^3.2",
        "nette/bootstrap": "^3.2",
        "nette/tester": "^2.5",
        "phloxcz/rpc-api": "^0.2@dev",
        "phpstan/phpstan": "^2.0",
        "tracy/tracy": "^2.10"
    },
    "suggest": {
        "nette/application": "To return Nette\\Application\\Response objects from controllers"
    },
    "autoload": {
        "psr-4": {
            "Phlox\\RestApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phlox\\RestApi\\Tests\\Fixtures\\": "tests/fixtures/"
        }
    },
    "scripts": {
        "test": "tester tests -C",
        "phpstan": "phpstan analyse",
        "check": [
            "@phpstan",
            "@test"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.3-dev"
        }
    }
}
